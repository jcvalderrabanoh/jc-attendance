# Misma BD que jc-core, pero el rol attendance_app solo escribe en el esquema attendance.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=attendance_app
POSTGRES_PASSWORD=
POSTGRES_DB=jc_core
# Mismo JWT_SECRET que jc-core: así se validan los tokens del patrón (claim app = attendance).
JWT_SECRET=
# Secreto propio para los tokens de empleado (OTP) y de kiosco.
EMPLOYEE_JWT_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3100
# URL pública del PWA para construir las ligas de alta.
PUBLIC_APP_URL=http://localhost:4300
# Envío de OTP: 'log' (desarrollo) o 'twilio'.
OTP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
