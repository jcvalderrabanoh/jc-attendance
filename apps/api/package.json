{
  "name": "@jc-attendance/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand --forceExit",
    "migration:run": "node scripts/db-prepare.js && typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/config/data-source.js",
    "db:prepare": "node scripts/db-prepare.js",
    "migration:run:dev": "node scripts/db-prepare.js && typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts"
  },
  "dependencies": {
    "@jc-attendance/rules-engine": "*",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.3.1",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^10.3.1",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.1",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.9",
    "@types/pdfmake": "^0.2.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@jc-attendance/rules-engine$": "<rootDir>/../../../libs/rules-engine/src"
    }
  }
}
