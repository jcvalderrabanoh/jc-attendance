{
  "name": "jc-attendance",
  "private": true,
  "description": "Checador: registro de entradas y salidas multicuenta",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:libs": "npm run build -w @jc-attendance/rules-engine -w @jc/platform-sdk",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
